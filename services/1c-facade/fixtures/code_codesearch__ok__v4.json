", "source_path": "/app/code/CommonModules/ДЕМО_Р_ТикетыБКИ/Ext/Module.bsl", "chunk_index": 0}, "document": "Процедура Заглушка()\n\t// тело вырезано при анонимизации\nКонецПроцедуры", "distance": 0.5940555334091187, "search_type": "vector", "rrf_score": 0.05851851851851852, "combined_score": 0.9921, "context": "Функция ПодатьТикет(Описание, УИдСобытия = Неопределено, Вложения = Неопределено) Экспорт\n\n\tТекстОписания = СокрЛП(Описание);\n\tЕсли ПустаяСтрока(ТекстОписания) Тогда\n\t\tВызватьИсключение НСтр(\"ru = 'Опишите проблему: тикет без описания не подаётся.'\");\n\tКонецЕсли;\n\n\tДанныеВложений = ПроверенныеВложения(Вложения);\n\n\tМоментПодачи = ТекущаяДатаСеанса();\n\tКонтекст = КонтекстСтруктурой(ИдентификаторСобытия(УИдСобытия), МоментПодачи);\n\n\tОбъект = Справочники.ДЕМО_Р_ТикетыБКИ.СоздатьЭлемент();\n\tОбъект.Наименование = ПерваяСтрока(ТекстОписания, Метаданные.Справочники.ДЕМО_Р_ТикетыБКИ.ДлинаНаименования);\n\tОбъект.Описание = ТекстОписания;\n\tОбъект.Автор = Пользователи.ТекущийПользователь();\n\tОбъект.МоментПодачи = МоментПодачи;\n\tОбъект.Статус = Перечисления.ДЕМО_Р_СтатусыТикетов.Новый;\n\tОбъект.ИмяБазы = Контекст.Контур.база;\n\tОбъект.ВерсияРасширения = Контекст.Контур.версияРасширения;\n\tОбъект.Контекст = КонтекстВJSON(Контекст);\n\n\tЕсли Контекст.УИдСобытия <> Неопределено Тогда\nОбъект.ИмяБазы = Контекст.Контур.база;\n\tОбъект.ВерсияРасширения = Контекст.Контур.версияРасширения;\n\tОбъект.Контекст = КонтекстВJSON(Контекст);\n\n\tЕсли Контекст.УИдСобытия <> Неопределено Тогда\n\t\tОбъект.УИдСобытия = Контекст.УИдСобытия;\n\t\tОбъект.КодСобытия = Контекст.КодСобытия;\n\tКонецЕсли;\n\n\tДля Каждого Вложение Из ДанныеВложений Цикл\n\t\tСтрокаВложения = Объект.Вложения.Добавить();\n\t\tСтрокаВложения.ИмяФайла = Вложение.ИмяФайла;\n\t\tСтрокаВложения.Размер = Вложение.ДвоичныеДанные.Размер();\n\t\tСтрокаВложения.Данные = Новый ХранилищеЗначения(Вложение.ДвоичныеДанные, Новый СжатиеДанных(9));\n\tКонецЦикла;\n\n\tОбъект.Записать();\n\n\tВозврат Объект.Код;\n\nКонецФункции", "origin": {"origin_kind": "base", "origin_id": "base", "source_path": "/app/code/CommonModules/ДЕМО_Р_ТикетыБКИ/Ext/Module.bsl"}, "item_id": "code:symbol:CommonModules/ДЕМО_Р_ТикетыБКИ/Ext/Module.bsl:ПодатьТикет:0", "location": "CommonModules/ДЕМО_Р_ТикетыБКИ/Ext/Module.bsl:51:89", "evidence_path": "CommonModules/ДЕМО_Р_ТикетыБКИ/Ext/Module.bsl", "score": 0.6273307165537421}, {"id": "645122243ef0bc817ae8ca280dd66ce42d904c02d892c080", "metadata": {"full_path": "Module_48889727.ВыгрузкаНаСервере", "name": "ВыгрузкаНаСервере", "symbol_type": "Function", "is_export": false, "directive": "НаСервере", "region": "СлужебныеПроцедурыИФункции", "start_line": 104, "end_line": 112, "module_name": "Module_48889727", "module_type": "Unknown", "owner_full_path": "Module_48889727", "source_file": "Module.bsl", "source_path": "/app/code/Catalogs/ДЕМО_Р_ТикетыБКИ/Forms/ФормаЭлемента/Ext/Form/Module.bsl", "chunk_index": 3}, "document": "Процедура Заглушка()\n\t// тело вырезано при анонимизации\nКонецПроцедуры", "distance": 0.6144334077835083, "search_type": "vector", "rrf_score": 0.05829228243021346, "combined_score": 0.9849, "origin": {"origin_kind": "base", "origin_id": "base", "source_path": "/app/code/Catalogs/ДЕМО_Р_ТикетыБКИ/Forms/ФормаЭлемента/Ext/Form/Module.bsl"}, "item_id": "code:symbol:Catalogs/ДЕМО_Р_ТикетыБКИ/Forms/ФормаЭлемента/Ext/Form/Module.bsl:ВыгрузкаНаСервере:0", "location": "Catalogs/ДЕМО_Р_ТикетыБКИ/Forms/ФормаЭлемента/Ext/Form/Module.bsl:104:112", "evidence_path": "Catalogs/ДЕМО_Р_ТикетыБКИ/Forms/ФормаЭлемента/Ext/Form/Module.bsl", "score": 0.6194123555538424}], "search_layer": "vector+bm25", "origin_filter": {"applied": false, "value": "all"}, "items_total": 5, "items_returned": 5, "truncated": false, "next_cursor": null, "detail_level": "full", "index_identity": "gen:20260928T111101Z-9b04cc74"}}