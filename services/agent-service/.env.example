# Copy this file to `.env`, fill in the blanks, then `docker compose up --build`.
# `.env` is gitignored — your key never leaves this machine.

# --- Required: your OpenAI API key (the assistant can't generate answers without it) ---
OPENAI_API_KEY=

# --- Optional: point at Azure OpenAI or a proxy instead of api.openai.com ---
# Leave blank for OpenAI. For Azure/proxy, set the base URL here.
OPENAI_BASE_URL=

# Models (override if you have access to others).
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Retrieval mode: "embeddings" (better, uses the key at startup) or "lexical" (no embed calls).
RETRIEVAL=embeddings
TOP_K=4

# --- Shared secret: put the SAME value in the 1C Constant TokenServicioAsistente ---
# Leave blank to disable auth (only acceptable for pure localhost testing).
ASSISTANT_BEARER_TOKEN=

# Append a "Fuente: …" line to answers (the Phase-1 1C form doesn't render citations yet).
APPEND_SOURCES_TO_TEXT=true
