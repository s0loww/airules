# Скопировать в .env (он в .gitignore) и заполнить. Ключи и токены живут только здесь.

# --- Реестр тенантов (внутри контейнера; compose монтирует tenants.yaml сюда) ---
TENANTS_FILE=/config/tenants.yaml

# --- Токены тенантов: имена — из token_env в tenants.yaml. То же значение ставится в
#     константу TokenServicioAsistente базы 1С. Сгенерировать:
#     python -c "import secrets; print(secrets.token_urlsafe(24))"
EC_ASSISTANT_TOKEN=

# --- Провайдер: OPENAI_* — любой OpenAI-совместимый endpoint. Вариант по умолчанию —
#     OpenRouter: один ключ на чат и эмбеддинги, модели с префиксом вендора
#     (deepseek/deepseek-v4-flash, openai/text-embedding-3-small).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Прямой DeepSeek (необязательно): используется только для «голых» имён моделей
#     без префикса (deepseek-v4-flash). Имена deepseek/... идут через OPENAI_BASE_URL.
# DEEPSEEK_API_KEY=

# --- Эмбеддинги: по умолчанию через тот же OPENAI_* endpoint. Отдельный endpoint — EMBED_*.
#     Нет ни того, ни другого — тенанты с retrieval=embeddings откатятся на лексический поиск.
EMBED_MODEL=openai/text-embedding-3-small
# EMBED_BASE_URL=
# EMBED_API_KEY=

# --- Значения по умолчанию для всех тенантов (реестр может переопределить) ---
CHAT_MODEL=deepseek/deepseek-v4-flash
TOP_K=4
APPEND_SOURCES_TO_TEXT=true
