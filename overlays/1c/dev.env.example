# Параметры 1С-проекта для rules/dev-standards-core.md (§1).
# При установке копируется в корень цели как .dev.env.example; рабочий файл —
# .dev.env (создаёт установщик, поля без значения — спросить или НЕ НАСТРОЕНО).
# Секретов здесь нет — файл можно коммитить.
# PREFIX и PLATFORM_VERSION обязаны совпадать с корневым контрактом и
# паспортом проекта (openspec/project.md); при расхождении — спросить.

PREFIX=xx_
COMPANY=<ИмяКомпании>
DEVELOPER=<ИмяРазработчика>
PLATFORM_VERSION=8.3.24
COMMENT_OPEN=// {COMPANY} {DEVELOPER} {DATE} {TASK} нач
COMMENT_CLOSE=// {COMPANY} {DEVELOPER} {DATE} {TASK} кон
NEW_OBJECTS_IN=main_configuration

# --- Инструменты скилла 1c-metadata-manage (читают сами; пусто = умолчание) ---
# Каталог установки платформы (содержит bin\1cv8.exe); пусто — самая свежая найденная.
PLATFORM_PATH=
# Каталог выгрузки исходников (для -Object обёртки Invoke-1CEdit); пусто — ближайший
# каталог с Configuration.xml.
EXPORT_PATH=
# Гейт поддержки поставщика в пишущих инструментах: deny (умолчание) | warn | off.
SUPPORT_GUARD=
# Куда ставить новый объект в ChildObjects Configuration.xml: end (умолчание) | byName.
NEW_OBJECT_POSITION=
# Доп. аргументы 1cv8.exe / ibcmd через запятую (например /UseHwLicenses+ / --dbms=PostgreSQL).
PLATFORM_ARGS=
IBCMD_ARGS=
# Пароль ИБ сюда НЕ пишется: переменная окружения + -PasswordEnv <ИМЯ> у обёртки.
