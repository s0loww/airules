# Шаблон файла окружения для COM-скриптов 1С.
#
# Скопируй этот файл в свой проект как `.env`, добавь `.env` в `.gitignore` и
# заполни реальными значениями. Файл `.env` НИКОГДА не коммитится — в нём креды.
# Здесь только угловые плейсхолдеры, ни одного реального значения.
#
# Формат разбирают функции библиотеки com-tools (Read-ComEnvFile,
# Get-ComProfileSettings). Практики и грабли COM/PowerShell —
# rules/com-powershell-1c.md.
#
# Профиль = секция [ИМЯ]. Имя профиля и путь к этому файлу передаются скрипту
# параметрами -Profile / -EnvPath (обязательные, без дефолтов).

# Файловая база: Mode=File + Path.
[MAIN]
Mode=File
Path=<путь-к-каталогу-файловой-базы>
Login=<логин>
Pass=***

# Серверная база: Mode=Server + Host + Ref.
[SOURCE]
Mode=Server
Host=<сервер-1С>
Ref=<имя-базы-на-сервере>
Login=<логин>
Pass=***

# Каталог логов COM-скриптов. Если пусто/не задано — используется
# var/com-tools-logs/ в корне проекта.
[COM]
LogPath=<путь-к-каталогу-логов>
